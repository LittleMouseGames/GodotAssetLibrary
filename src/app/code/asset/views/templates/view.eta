<%
  const loggedIn = it?._locals?.loggedIn
  const generateProxyUrl = it?._locals?.functions?.generateProxyUrl
  const buildAssetUrl = it?._locals?.functions?.buildAssetUrl

  var upvotes = Number(it?.info?.upvotes) || 0
  var downvotes = Number(it?.info?.downvotes) || 0
  var total = upvotes + downvotes
  var percent = 0
  var assetPath = buildAssetUrl(it?.info?.asset_id, it?.info?.title)
  var assetUrl = `https://godotassetlibrary.com${assetPath}`

  // Truthful application category: developer tools are DeveloperApplication,
  // everything else stays a generic GameApplication category.
  var appCategory = 'GameApplication'
  if (/tool/i.test(it?.info?.category ?? '')) appCategory = 'DeveloperApplication'

  // Schema.org expects a Date/DateTime; prefer the normalized date.
  var modifiedDate = it?.info?.modify_date_at ?? it?.info?.modify_date ?? undefined

  if (total !== 0) {
    percent = Math.round((upvotes / total) * 100)
  }

  var breadcrumbItems = []
  if (it?.pageBanner?.breadcrumb != null) {
    it.pageBanner.breadcrumb.forEach((item, index) => {
      var itemUrl = item.url != null && item.url !== ''
        ? `https://godotassetlibrary.com${item.url}`
        : assetUrl
      breadcrumbItems.push({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: itemUrl
      })
    })
  }

  it.meta = {
    title: `${it?.info?.title ?? 'Asset'} | Godot Asset Library`,
    description: it?.info?.quick_description ??  `Find out more about the ${it?.info?.title ?? ''} Godot asset on Godot Asset Library.`,
    url: assetUrl,
    moduleName: 'asset',
    noindex: it?.noindex === true,
    jsonLd: {
      "@context": "https://schema.org/",
      "@type": "SoftwareApplication",
      "name": it?.info?.title,
      "description": it?.info?.quick_description,
      "image": it?.info?.card_banner ?? it?.info?.icon_url,
      "url": assetUrl,
      "author": { "@type": it?.info?.provider === 'godot_store' ? 'Organization' : 'Person', "name": it?.info?.author },
      "softwareVersion": it?.info?.version_string,
      "applicationCategory": appCategory,
      "softwareRequirements": `Godot ${it?.info?.compatibility_label ?? it?.info?.godot_version ?? ''}`.replace('Godot Godot', 'Godot')
    },
    image: generateProxyUrl(it.info.card_banner ?? it.info.icon_url),
  }

  // Store assets carry real license + price facts that Schema.org can express.
  if (it?.info?.provider === 'godot_store') {
    var storeOffer = {
      "@type": "Offer",
      "price": it?.info?.is_free === true ? '0' : (String(it?.info?.cost ?? '0').replace(/[^\d.,]/g, '') || '0'),
      "priceCurrency": it?.info?.price_currency ?? 'EUR',
      "url": it?.info?.store_url ?? assetUrl
    }
    it.meta.jsonLd.offers = storeOffer
    if (it?.info?.license_url) {
      it.meta.jsonLd.license = it.info.license_url
    } else if (it?.info?.license_type) {
      it.meta.jsonLd.license = it.info.license_type
    }
  }

  // dateModified and BreadcrumbList are only valid when we have the data.
  if (modifiedDate !== undefined) {
    it.meta.jsonLd.dateModified = modifiedDate
  }
  if (breadcrumbItems.length > 0) {
    it.meta.jsonLdBreadcrumb = {
      "@context": "https://schema.org/",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems
    }
  }

  // Related guide links chosen by the asset's category, for deep internal
  // linking between the catalog and the guides.
  var guideLinks = []
  var categoryKey = String(it?.info?.category_lowercase ?? '').toLocaleLowerCase()
  if (categoryKey === 'shaders' || categoryKey === 'materials') {
    guideLinks.push({ url: '/guides/how-to-use-shaders-in-godot', label: 'How to use shaders in Godot' })
  }
  if (categoryKey === 'tools' || categoryKey === '2d tools' || categoryKey === '3d tools' || categoryKey === 'scripts') {
    guideLinks.push({ url: '/guides/how-to-install-godot-plugins', label: 'How to install Godot plugins' })
  }
  if (categoryKey === 'templates' || categoryKey === 'projects' || categoryKey === 'demos') {
    guideLinks.push({ url: '/guides/how-to-install-godot-assets', label: 'How to install Godot assets' })
  }
  guideLinks.push({ url: '/guides/how-to-choose-a-godot-asset', label: 'How to choose a Godot asset' })
  it.guideLinks = guideLinks
%>
<% layout('templates/components/layouts/promobar-nav-body-footer/promobar-nav-body-footer.eta') %>

<%~ includeFile('templates/components/partials/modal-install/modal-install.eta', it) %>
<%~ includeFile('templates/components/partials/modal-report/modal-report.eta') %>
<%~ includeFile('templates/components/partials/modal-delete/modal-delete.eta') %>
<%~ includeFile('templates/components/partials/modal-media/modal-media.eta') %>

<section class="page-asset">
  <div class="column">
    <% const mediaItems = it?.mediaItems ?? [] %>
    <% const primaryMedia = it?.primaryMedia ?? null %>
    <% const fallbackImage = it?.fallbackImage ?? '/images/noimage.png' %>
    <div class="media<%= mediaItems.length <= 1 ? ' single-image' : '' %>">
      <div class="player">
        <div class="container" data-media-stage>
          <div class="media-layer media-image-layer" style="<%= primaryMedia?.type === 'video' ? 'display: none;' : '' %>">
            <button type="button" class="media-image-button" data-media-index="<%= primaryMedia?.type === 'image' ? 0 : '' %>"
              aria-label="Open <%= it?.info?.title %> preview image">
              <img class="media-frame media-image" data-media-type="image"
                src="<%= generateProxyUrl(primaryMedia?.type === 'image' ? primaryMedia.url : fallbackImage, 1920, 1080) %>"
                data-fallback-image="<%= primaryMedia?.type === 'image' ? primaryMedia.url : fallbackImage %>"
                data-media-url="<%= primaryMedia?.type === 'image' ? primaryMedia.url : fallbackImage %>"
                width="1920" height="1080"
                alt="<%= it?.info?.title %> preview image" fetchpriority="high" decoding="async">
            </button>
          </div>
          <div class="media-layer media-video-layer"
            data-media-video-layer
            data-media-url="<%= primaryMedia?.type === 'video' ? primaryMedia.embedUrl : '' %>"
            style="<%= primaryMedia?.type === 'video' ? '' : 'display: none;' %>">
            <button type="button" class="video-cover" data-media-play aria-label="Play video preview">
              <img class="video-poster"
                src="<%= primaryMedia?.type === 'video' ? generateProxyUrl(primaryMedia.thumbnail, 1280, 720) : '' %>"
                data-fallback-image="<%= primaryMedia?.type === 'video' ? primaryMedia.thumbnail : '' %>"
                alt="" loading="lazy" decoding="async">
              <span class="video-play-icon" aria-hidden="true">&#9654;</span>
            </button>
            <iframe class="media-frame media-video" data-media-iframe width="100%" height="100%" frameborder="0"
              src="about:blank" style="display: none;"
              title="<%= it?.info?.title %> video preview"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <% if (mediaItems.length > 1) { %>
          <button type="button" class="media-prev" data-media-prev aria-label="Previous media">&#8249;</button>
          <button type="button" class="media-next" data-media-next aria-label="Next media">&#8250;</button>
          <% } %>
          <div class="media-counter" data-media-counter aria-live="polite"><%= mediaItems.length > 1 ? `1 / ${mediaItems.length}` : '' %></div>
        </div>
      </div>
      <% if(mediaItems.length > 1) { %>
      <div class="thumbnails" data-media-rail>
        <button type="button" class="rail-arrow rail-prev" data-media-rail-prev aria-label="Scroll thumbnails back">&#8249;</button>
        <div class="rail-viewport" data-media-rail-viewport>
          <div class="rail-track" data-media-rail-track>
            <% mediaItems.forEach((item, index) => { %>
            <button type="button" class="thumbnail-btn<%= index === 0 ? ' active' : '' %>"
              data-media-index="<%= index %>" data-media-type="<%= item.type %>"
              data-media-url="<%= item.type === 'video' ? item.embedUrl : item.url %>"
              data-media-image-url="<%= item.url %>"
              data-media-display-url="<%= item.type === 'image' ? generateProxyUrl(item.url, 1920, 1080) : '' %>"
              aria-current="<%= index === 0 ? 'true' : 'false' %>"
              aria-label="<%= item.type === 'video' ? `View video ${index + 1}` : `View image ${index + 1}` %>">
              <img src="<%= generateProxyUrl(item.thumbnail, 150, 84) %>"
                data-fallback-image="<%= item.thumbnail %>" alt="<%= it?.info?.title %> <%= item.type === 'video' ? 'video' : 'image' %> <%= index + 1 %>"
                loading="lazy" decoding="async">
              <% if (item.type === 'video') { %><span class="thumb-play" aria-hidden="true">&#9654;</span><% } %>
            </button>
            <% }) %>
          </div>
        </div>
        <button type="button" class="rail-arrow rail-next" data-media-rail-next aria-label="Scroll thumbnails forward">&#8250;</button>
      </div>
      <% } %>
    </div>
    <div class="info">
      <div class="details">
        <div class="section mobile-quick-info">
          <%~ includeFile('./quick-info.eta', it) %>
        </div>
        <div class="section docs">
          <label class="inline-dropdown">
            <h2>Asset Description</h2>
            <% if (it.info.readme) { %>
            <div class="dropdown no-text-select docs-source">
              <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
                aria-controls="docs-source-panel"
                onclick="window.godotLibrary.dropdown.showContent(event, this)">
                <span class="value" id="docs-source-value">README.md</span>
                <span class="iconify" data-icon="bxs:chevron-down"></span>
              </button>
              <div class="options" id="docs-source-panel">
                <button type="button" data-docs-source="readme"
                  onclick="window.godotLibrary.docs.switchTo('readme')">README.md</button>
                <button type="button" data-docs-source="description"
                  onclick="window.godotLibrary.docs.switchTo('description')">Description</button>
              </div>
            </div>
            <% } %>
          </label>
          <% if (it.info.readme) { %>
          <div class="readme active markdown-body" id="asset-readme-panel">
            <%~ it.info.readme %>
          </div>
          <% } %>
          <div class="description <%= it.info.readme ? '' : 'active' %> markdown-body" id="asset-description-panel">
            <p class="plain-description"><%= it?.info?.description ?? '' %></p>
            <% if (typeof it?.info?.store_body === 'string' && it.info.store_body !== '') { %>
            <div class="store-body"><%~ it.info.store_body %></div>
            <% } %>
          </div>
        </div>

        <div class="section" id="reviews">
          <h2>Reviews</h2>
          <% if (it?.reviewCount != null) { %>
          <div class="reviews-count"><%= it.reviewCount %> total review<%= it.reviewCount === 1 ? '' : 's' %><% if (it.reviewCount > (it?.reviewsShown ?? 0)) { %> &middot; showing the <%= it.reviewsShown %> most recent<% } %></div>
          <% } %>
          <%~ includeFile('templates/components/partials/stars/stars.eta', it) %>

          <div class="reviews">
            <% if (it?.comments) { %>
            <% const comments = it?.comments ?? [] %>
            <% comments.forEach(comment => { %>
            <div class="review">
              <div class="header">
                <span class="headline"><%= comment.headline %></span>
                <div class="dropdown no-text-select">
                  <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
                    aria-label="Review options"
                    onclick="window.godotLibrary.dropdown.showContent(event, this)">
                    <span class="iconify" data-icon="akar-icons:more-horizontal"></span>
                  </button>
                  <div class="options">
                    <button type="button" data-dialog-open="report"
                      data-report-comment-id="<%= String(comment.human_id) %>">Report</button>
                  </div>
                </div>
              </div>
              <span class="username"><%= comment.username %></span>
              <span class=" rated">Rated <%= comment.review_type %></span>
              <% if (comment.date != null) { %>
              <span class="review-date"><%= new Date(comment.date).toLocaleDateString() %></span>
              <% } %>
              <div class="review-body">
                <%= comment.text %>
              </div>
            </div>
            <% }) %>
            <% } %>
          </div>
          <% if (it?.reviewsHasMore === true && it?.reviewsNextUrl) { %>
          <a class="load-more-reviews" href="<%= it.reviewsNextUrl %>" title="Load more reviews">
            Load more reviews
          </a>
          <% } %>
        </div>
        <div class="section">
          <% var loggedInUser = it?._locals?.loggedIn === true %>
          <form method="POST" action="/asset/review/<%= it?.info?.asset_id %>" class="write-review"
            onsubmit="window.godotLibrary.formTools.sendFormAjax(event, this)">
            <h2>Your Rating</h2>
            <fieldset class="rating-fieldset">
              <legend class="visually-hidden">How do you rate this asset?</legend>
              <label class="rating-select">
                <input type="radio" name="rating" value="positive" required
                  <%= it?.usersAssetReview?.review_type === 'positive' ? 'checked' : '' %>
                  <% if(!loggedInUser) { %>disabled<% } %>>
                <div class="label <% if(!loggedInUser) { %>disabled<% } %>">
                  <span class="iconify" data-icon="bi:hand-thumbs-up-fill"></span>
                  <span>This addon is good</span>
                </div>
              </label>
              <label class="rating-select">
                <input type="radio" name="rating" value="negative" required
                  <%= it?.usersAssetReview?.review_type === 'negative' ? 'checked' : '' %>
                  <% if(!loggedInUser) { %>disabled<% } %>>
                <div class="label <% if(!loggedInUser) { %>disabled<% } %>">
                  <span class="iconify" data-icon="bi:hand-thumbs-down-fill"></span>
                  <span>This addon is not good</span>
                </div>
              </label>
            </fieldset>
            <div class="requirement" id="review-headline-hint">Headline must be at least 3 characters but not more than 50</div>
            <div class="input-container">
              <input name="asset_review_headline" class="input" id="asset-review-headline" type="text" placeholder=" "
                minlength="3" maxlength="50" aria-describedby="review-headline-hint"
                value="<%= it?.usersAssetReview?.headline ? it?.usersAssetReview?.headline : '' %>"
                <% if(!loggedInUser) { %>disabled<% } %>>
              <label for="asset-review-headline" class="placeholder">Headline (optional)</label>
            </div>
            <div class="requirement" id="review-body-hint">Review must be at least 5 characters but not more than 500</div>
            <div class="input-container">
              <textarea name="asset_review" class="input" id="asset-review" placeholder=" "
                minlength="5" maxlength="500" aria-describedby="review-body-hint"
                <% if(!loggedInUser) { %>disabled<% } %>><%= it?.usersAssetReview?.text ? it?.usersAssetReview?.text : '' %></textarea>
              <label for="asset-review" class="placeholder">Review (optional)</label>
            </div>
            <div class="actions">
              <% if(loggedInUser) { %>
              <button type="submit"><%= it?.hasUserReviewedAsset ? 'Update' : 'Submit' %></button>
              <% } %>
              <% if(!loggedInUser) { %>
              <div class="notice">
                Please <a href="/register" title="Go to login / register page">sign in</a> to add a review
              </div>
              <% } %>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="desktop-quick-info">
    <%~ includeFile('./quick-info.eta', it) %>
  </div>
  <% if (it?.relatedAssets?.length > 0) { %>
  <div class="related-assets">
    <div class="section-head">
      <h2>Related Assets</h2>
      <a class="view-all" href="/category/<%= it?.info?.category_lowercase ?? '' %>"
        title="See more in <%= it?.info?.category ?? 'this category' %>">More in <%= it?.info?.category ?? 'category' %></a>
    </div>
    <div class="related-grid">
      <% it.relatedAssets.forEach(info => { %>
      <%~ includeFile('templates/components/partials/asset-card/asset-card.eta', { info: info, _locals: it?._locals }) %>
      <% }) %>
    </div>
  </div>
  <% } %>
  <% if (it?.guideLinks?.length > 0) { %>
  <div class="related-guides">
    <div class="section-head">
      <h2>Related Guides</h2>
      <a class="view-all" href="/guides" title="All guides">All guides</a>
    </div>
    <ul class="guide-links">
      <% it.guideLinks.forEach(link => { %>
      <li><a href="<%= link.url %>" title="<%= link.label %>"><%= link.label %></a></li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</section>
