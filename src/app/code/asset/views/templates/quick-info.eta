<% 
var generateProxyUrl = it?._locals?.functions?.generateProxyUrl
%>

<div class="quick-info">
  <h2>Quick Information</h2>
  <%~ includeFile('templates/components/partials/stars/stars.eta', it) %>
  <div class="card">
    <div class="banner">
      <div class="badges">
        <a href="/category/<%= it?.info?.category?.toLocaleLowerCase() %>" title="See assets in this category">
          <div class="badge badge-blue"><%= it?.info?.category ?? 'ERR' %></div>
        </a>
        <a href="/engine/<%= it?.info?.godot_version?.toLocaleLowerCase() %>"
          title="See assets for this engine version">
          <div class="badge badge-purple"><%= it?.info?.godot_version ?? 'ERR' %></div>
        </a>
        <div class="dropdown no-text-select">
          <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
            aria-controls="quick-info-menu"
            onclick="window.godotLibrary.dropdown.showContent(event, this)">
            <span class="iconify" data-icon="akar-icons:more-horizontal"></span>
          </button>
          <div class="options" id="quick-info-menu">
            <% if (it?._locals?.loggedIn === true) { %>
            <button type="button" class="save-toggle" data-save-asset="<%= it?.info?.asset_id %>"
              data-saved="<%= it?.info?.saved === true ? 'true' : 'false' %>"
              aria-pressed="<%= it?.info?.saved === true ? 'true' : 'false' %>"
              title="<%= it?.info?.saved === true ? 'Remove asset from saved list' : 'Add asset to saved list' %>">
              <%= it?.info?.saved === true ? 'Unsave' : 'Save' %>
            </button>
            <% } else { %>
            <a href="/register" title="Sign in to save assets">Sign in to save</a>
            <% } %>
            <% if(it?._locals?.role === 'admin') { %>
            <% if(it?.info?.featured === true) { %>
            <a href="/admin/feature-post/<%= it?.info?.asset_id %>"
              onclick="window.godotLibrary.dropdown.callRouteAjax(event, '/admin/feature-post/<%= it?.info?.asset_id %>', 'Asset unfeatured')"
              title="Remove from 'Assets We Love' on homepage">
              Unfeature
            </a>
            <% } else { %>
            <a href="/admin/feature-post/<%= it?.info?.asset_id %>"
              onclick="window.godotLibrary.dropdown.callRouteAjax(event, '/admin/feature-post/<%= it?.info?.asset_id %>', 'Asset featured')"
              title="Add to 'Assets We Love' on homepage">
              Feature
            </a>
            <% } %>
            <% } %>
          </div>
        </div>
      </div>
      <% if (!it?.featured) { %>
      <div class="background">
        <div class="mask">
          <img src="<%= generateProxyUrl(it?.info?.card_banner ?? it?.info?.icon_url, 100, 100) %>"
            data-src="<%= generateProxyUrl(it?.info?.card_banner ?? it?.info?.icon_url) %>"
            data-fallback-image="<%= it?.info?.card_banner ?? it?.info?.icon_url %>"
            alt="<%= it?.info?.title %> preview image" class="lazyload">
        </div>
      </div>
      <% } %>
    </div>
    <div class="body">
      <div class="top">
        <div class="icon">
          <img
            src="<%= generateProxyUrl(it?.info?.icon_url ?? 'https://avatars.githubusercontent.com/u/42072863?s=200&v=4', 50, 50) %>"
            data-fallback-image="<%= it?.info?.icon_url ?? 'https://avatars.githubusercontent.com/u/42072863?s=200&v=4' %>"
            alt="<%= it?.info?.title %> icon image">
        </div>
        <div class="info">
          <div class="author"><%= it?.info?.author ?? 'Failed to load'%></div>
          <div class="title"><%= it?.info?.title ?? 'Unable to load the asset 😿' %></div>
        </div>
      </div>
      <p>
        <%= it?.info?.quick_description ?? 'For some reason we\'re unable to load this asset information right now' %>
      <div class="specs">
        <div class="row">
          <div class="property">Supported Engine Version</div>
          <div class="value"><%= it?.info?.godot_version ?? 'Unknown' %></div>
        </div>
        <div class="row">
          <div class="property">Version String</div>
          <div class="value"><%= it?.info?.version_string ?? 'Unknown' %></div>
        </div>
        <div class="row">
          <div class="property">Support Level</div>
          <div class="value"><%= it?.info?.support_level ?? 'Unknown' %></div>
        </div>
        <div class="row">
          <div class="property">Modified Date</div>
          <div class="value" title="<%= it?.info?.modify_date ?? 'Unknown' %>">
            <%= it?.info?.modify_date_pretty ?? 'Unknown' %></div>
        </div>
        <% const browseUrl = it?.info?.browse_url ?? '' %>
        <% const issuesUrl = it?.info?.issues_url ?? '' %>
        <% if (typeof browseUrl === 'string' && /^https?:\/\//i.test(browseUrl)) { %>
        <div class="row">
          <div class="property">Git URL</div>
          <div class="value"><a href="<%= browseUrl %>" target="_blank" rel="noopener noreferrer"
              title="Open asset Git repository">Link to Git URL</a></div>
        </div>
        <% } %>
        <% if (typeof issuesUrl === 'string' && /^https?:\/\//i.test(issuesUrl)) { %>
        <div class="row">
          <div class="property">Issue URL</div>
          <div class="value"><a href="<%= issuesUrl %>" target="_blank" rel="noopener noreferrer"
              title="Open asset issue tracker">Link to Issues URL</a></div>
        </div>
        <% } %>
      </div>
      <% const downloadUrl = it?.info?.download_url ?? '' %>
      <div class="actions">
        <% if (typeof downloadUrl === 'string' && downloadUrl !== '') { %>
        <a class="action primary" href="<%= downloadUrl %>" target="_blank" rel="noopener noreferrer"
          title="Download the asset ZIP archive">Download ZIP</a>
        <% } %>
        <button class="action secondary" type="button" data-dialog-open="install"
          title="Open installation instructions">Installation help</button>
      </div>
    </div>
  </div>
</div>
