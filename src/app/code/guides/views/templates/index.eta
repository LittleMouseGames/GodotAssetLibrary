<%
  it.meta = {
    title: 'Godot Asset Guides | Godot Asset Library',
    description: 'Learn how to install Godot assets, use shaders, choose compatible plugins and get more out of the Godot Asset Library with free guides.',
    url: 'https://godotassetlibrary.com/guides',
    moduleName: 'guides',
    image: 'https://godotassetlibrary.com/images/logo-image.png',
    jsonLd: {
      "@context": "https://schema.org/",
      "@type": "CollectionPage",
      "name": "Godot Asset Guides",
      "url": "https://godotassetlibrary.com/guides",
      "description": "Learn how to install Godot assets, use shaders, choose compatible plugins and get more out of the Godot Asset Library."
    },
    jsonLdBreadcrumb: {
      "@context": "https://schema.org/",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://godotassetlibrary.com/" },
        { "@type": "ListItem", position: 2, name: "Guides", item: "https://godotassetlibrary.com/guides" }
      ]
    }
  }
  it.pageBanner = {
    title: 'Godot Asset Guides',
    info: 'Learn how to install, use and choose Godot assets &mdash; free guides from the Godot Asset Library',
    breadcrumb: [
      { label: 'Home', url: '/' },
      { label: 'Guides', url: '' }
    ]
  }
%>
<% layout('templates/components/layouts/promobar-nav-body-footer/promobar-nav-body-footer.eta') %>

<section class="page-guides">
  <% if (it.guides?.length > 0) { %>
  <div class="guides-grid">
    <% it.guides.forEach(guide => { %>
    <%~ includeFile('templates/components/partials/guide-card/guide-card.eta', { guide: guide, _locals: it?._locals }) %>
    <% }) %>
  </div>
  <% } else { %>
  <p class="section-empty">Guides are on their way.</p>
  <% } %>
</section>
