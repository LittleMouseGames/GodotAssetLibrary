<%
  var breadcrumbItems = []
  if (it?.search?.breadcrumb != null) {
    it.search.breadcrumb.forEach((item, index) => {
      var itemUrl = item.url != null && item.url !== ''
        ? `https://godotassetlibrary.com${item.url}`
        : `https://godotassetlibrary.com${it?.canonicalUrl ?? it?.params}`
      breadcrumbItems.push({ '@type': 'ListItem', position: index + 1, name: item.label, item: itemUrl })
    })
  }
  // Only indexable pages get an ItemList; noindex search/filter views skip it.
  var itemListElements = []
  if (it?.noindex !== true && it?.grid != null) {
    it.grid.forEach((asset, index) => {
      itemListElements.push({
        '@type': 'ListItem',
        position: index + 1,
        name: asset.title,
        url: `https://godotassetlibrary.com${it?._locals?.functions?.buildAssetUrl(asset.asset_id, asset.title)}`
      })
    })
  }
  it.meta = {
    title: it?.search?.title ?? 'Search | Godot Asset Library',
    description: it?.search?.description ?? 'Find the best Godot assets on Godot Asset Library',
    url: `https://godotassetlibrary.com${it?.canonicalUrl ?? it?.params}`,
    moduleName: 'search',
    noindex: it?.noindex === true,
    jsonLdBreadcrumb: breadcrumbItems.length > 0 ? {
      '@context': 'https://schema.org/',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems
    } : undefined,
    jsonLdItemList: itemListElements.length > 0 ? {
      '@context': 'https://schema.org/',
      '@type': 'ItemList',
      name: it?.search?.title ?? 'Godot assets',
      itemListElement: itemListElements
    } : undefined
  }
%>
<% layout('templates/components/layouts/promobar-nav-body-footer/promobar-nav-body-footer.eta') %>

<section class="page-search">
  <section class="filters-column">
    <button type="button" class="filters-toggle" aria-expanded="false" aria-controls="search-filters-form"
      onclick="window.godotLibrary.search.toggleFilters(event)">
      <span>Filters (<%= it.search.activeFilterCount %>)</span>
      <span class="iconify" data-icon="bxs:chevron-down"></span>
    </button>

    <form method="GET" action="/search/" class="catalog-filters" id="search-filters-form">
      <input type="hidden" name="q" value="<%= it.search.query %>">
      <input type="hidden" name="sort" value="<%= it.search.currentSort %>">
      <input type="hidden" name="limit" value="<%= it.search.currentLimit %>">

      <div class="filter accordion" id="filter-sources">
        <div class="accordion-trigger no-text-select">
          <h2>
            Source
            <span class="iconify icon-close" data-icon="bxs:chevron-up"></span>
            <span class="iconify icon-expand" data-icon="bxs:chevron-down"></span>
          </h2>
        </div>
        <div class="options accordion-content">
          <ul>
            <li>
              <label>
                <input type="radio" name="source" value="" <%= it.search.source === '' ? 'checked' : '' %>>
                All sources
              </label>
            </li>
            <% for (const source of it.search.sources) { %>
            <li>
              <label>
                <input type="radio" name="source" value="<%= source.value %>"
                  <%= source.checked ? 'checked' : '' %>>
                <%= source.label %> (<%= source.count %>)
              </label>
            </li>
            <% } %>
          </ul>
          <% if (it.search.source !== '') { %>
          <a class="clear-section" href="<%= it.search.sourceClearUrl %>" title="Clear source filter">Clear section</a>
          <% } %>
        </div>
      </div>

      <div class="filter accordion" id="filter-categories">
        <div class="accordion-trigger no-text-select">
          <h2>
            Category Filters
            <span class="iconify icon-close" data-icon="bxs:chevron-up"></span>
            <span class="iconify icon-expand" data-icon="bxs:chevron-down"></span>
          </h2>
        </div>
        <div class="options accordion-content">
          <ul>
            <% for (const category of it.search.categories) { %>
            <li>
              <label>
                <input type="checkbox" name="category" value="<%= category.value %>"
                  <%= category.checked ? 'checked' : '' %>>
                <%= category.label %> (<%= category.count %>)
              </label>
            </li>
            <% } %>
          </ul>
          <% if (it.search.categories.some(c => c.checked)) { %>
          <a class="clear-section" href="<%= it.search.categoryClearUrl %>" title="Clear category filters">Clear section</a>
          <% } %>
        </div>
      </div>

      <div class="filter accordion" id="filter-engines">
        <div class="accordion-trigger no-text-select">
          <h2>
            Godot Version
            <span class="iconify icon-close" data-icon="bxs:chevron-up"></span>
            <span class="iconify icon-expand" data-icon="bxs:chevron-down"></span>
          </h2>
        </div>
        <div class="options accordion-content">
          <ul>
            <% for (const engine of it.search.engines) { %>
            <li>
              <label>
                <input type="checkbox" name="engine" value="<%= engine.value %>"
                  <%= engine.checked ? 'checked' : '' %>>
                Godot <%= engine.label %> (<%= engine.count %>)
              </label>
            </li>
            <% } %>
          </ul>
          <% if (it.search.engines.some(e => e.checked)) { %>
          <a class="clear-section" href="<%= it.search.engineClearUrl %>" title="Clear engine filters">Clear section</a>
          <% } %>
        </div>
      </div>

      <div class="filter accordion" id="filter-types">
        <div class="accordion-trigger no-text-select">
          <h2>
            Asset Type
            <span class="iconify icon-close" data-icon="bxs:chevron-up"></span>
            <span class="iconify icon-expand" data-icon="bxs:chevron-down"></span>
          </h2>
        </div>
        <div class="options accordion-content">
          <ul>
            <% for (const type of it.search.types) { %>
            <li>
              <label>
                <input type="checkbox" name="type" value="<%= type.value %>"
                  <%= type.checked ? 'checked' : '' %>>
                <%= type.label %> (<%= type.count %>)
              </label>
            </li>
            <% } %>
          </ul>
          <% if (it.search.types.some(t => t.checked)) { %>
          <a class="clear-section" href="<%= it.search.typeClearUrl %>" title="Clear asset type filters">Clear section</a>
          <% } %>
        </div>
      </div>

      <div class="filter accordion" id="filter-supports">
        <div class="accordion-trigger no-text-select">
          <h2>
            Support Level
            <span class="iconify icon-close" data-icon="bxs:chevron-up"></span>
            <span class="iconify icon-expand" data-icon="bxs:chevron-down"></span>
          </h2>
        </div>
        <div class="options accordion-content">
          <ul>
            <% for (const support of it.search.supports) { %>
            <li>
              <label>
                <input type="checkbox" name="support" value="<%= support.value %>"
                  <%= support.checked ? 'checked' : '' %>>
                <%= support.label %> (<%= support.count %>)
              </label>
            </li>
            <% } %>
          </ul>
          <% if (it.search.supports.some(s => s.checked)) { %>
          <a class="clear-section" href="<%= it.search.supportClearUrl %>" title="Clear support level filters">Clear section</a>
          <% } %>
        </div>
      </div>

      <label class="filter-featured">
        <input type="checkbox" name="featured" value="true" <%= it.search.featured ? 'checked' : '' %>>
        Featured only
      </label>

      <button type="submit" class="apply-filters">Apply filters</button>
    </form>
  </section>

  <section>
    <%~ includeFile('templates/components/partials/catalog-grid/catalog-grid.eta', it) %>
    <% if (it?.relatedForSearch?.length > 0) { %>
    <div class="related-for-search">
      <div class="section-head">
        <h2>You may also like</h2>
      </div>
      <div class="related-grid">
        <% it.relatedForSearch.forEach(info => { %>
        <%~ includeFile('templates/components/partials/asset-card/asset-card.eta', { info: info, _locals: it?._locals, sourceUrl: it?.params }) %>
        <% }) %>
      </div>
    </div>
    <% } %>
  </section>
</section>

<% if (it?.categoryContent != null) { %>
<section class="taxonomy-intro">
  <p><%= it.categoryContent.intro %></p>
  <ul class="taxonomy-bullets">
    <% it.categoryContent.bullets.forEach(bullet => { %>
    <li><%= bullet %></li>
    <% }) %>
  </ul>
  <% if (it.categoryContent.guides.length > 0) { %>
  <p class="taxonomy-guides">
    <strong>Related guides:</strong>
    <% it.categoryContent.guides.forEach((guide, index) => { %>
    <a href="<%= guide.href %>" title="<%= guide.label %>"><%= guide.label %></a><%= index < it.categoryContent.guides.length - 1 ? ' · ' : '' %>
    <% }) %>
  </p>
  <% } %>
</section>
<% } else if (it?.routeEngine != null) { %>
<section class="taxonomy-intro">
  <p>These <strong><%= it?.search?.pagination?.total ?? 0 %></strong> assets are compatible with Godot <strong><%= it.routeEngine %></strong>. Use the filters to narrow by category, asset type or support level, and always confirm the version badge on the asset page before installing. Read <a href="/guides/how-to-choose-a-godot-asset" title="How to choose a Godot asset">how to choose a Godot asset</a> for the full checklist.</p>
</section>
<% } %>
