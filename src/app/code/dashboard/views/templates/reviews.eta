<% it.meta = {
  title: 'Ratings & Reviews | Godot Asset Library',
  description: 'Manage your Godot Asset Library experience',
  url: 'https://godotassetlibrary.com/dashboard/reviews',
  moduleName: 'dashboard'
} %>
<% layout('templates/components/layouts/promobar-nav-body-footer/promobar-nav-body-footer.eta') %>

<section class="page-dashboard reviews">
  <div class="column">
    <%~ includeFile('./components/sidebar.eta', it) %>
  </div>
  <div class="column">
    <%~ includeFile('./components/review-list.eta', it) %>
  </div>
</section>
