<% 
var generateProxyUrl = it?._locals?.functions?.generateProxyUrl
var cardImage = it?.info?.card_banner ?? it?.info?.icon_url ?? '/images/noimage.png'

if (typeof cardImage !== 'string' || /(?:youtube\.com|youtu\.be|\.(?:mp4|webm|mov))(?:[?#]|$)/i.test(cardImage)) {
  cardImage = it?.info?.icon_url ?? '/images/noimage.png'
}

var assetId = it?.info?.asset_id ?? ''
// Linked projects share a group: cards link to the canonical project URL (the
// group root) so a Store/legacy variant never points at a redirect.
var linkId = it?.info?.group_id != null && it?.info?.group_id !== '' ? it?.info?.group_id : assetId
var buildAssetUrlWithReturn = it?._locals?.functions?.buildAssetUrlWithReturn
var assetHref = typeof buildAssetUrlWithReturn === 'function'
  ? buildAssetUrlWithReturn(linkId, String(it?.info?.title ?? ''), it?.sourceUrl ?? '')
  : `/asset/${linkId}`

var upvotes = Number(it?.info?.upvotes) || 0
var downvotes = Number(it?.info?.downvotes) || 0
var total = upvotes + downvotes
var approval = total > 0 ? Math.round((upvotes / total) * 100) : 0
// Store assets carry an upstream net-vote score. Surface it on cards only
// when there are no LOCAL ratings, and always mark it so it can't be confused
// with a review on this site.
var storeScore = it?.info?.provider === 'godot_store' && it?.info?.source_rating?.score != null
  ? Number(it.info.source_rating.score)
  : null
var storeScoreDisplay = storeScore !== null ? `${storeScore >= 0 ? '+' : ''}${storeScore}` : ''
var ratingDetail = total > 0
  ? `${approval}% approval (${upvotes} positive, ${downvotes} negative)`
  : (storeScore !== null
      ? `No local ratings yet; Godot Asset Store score ${storeScoreDisplay}`
      : 'No ratings yet')
%>

<article class="asset-card <%= it?.featured ? 'featured' : 'normal' %>" id="asset-<%= assetId %>">
  <div class="head">
    <div class="badges">
      <a class="badge badge-blue" href="<%= it?._locals?.functions?.buildCategoryPath(it?.info?.category) %>"
        title="See assets in this category"><%= it?.info?.category ?? 'ERR' %></a>
      <a class="badge badge-purple" href="<%= it?._locals?.functions?.buildEnginePath(it?.info?.godot_version) %>"
        title="See assets for this engine version"><%= it?.info?.godot_version ?? 'ERR' %></a>
      <% if (it?.info?.provider === 'godot_store') { %>
      <a class="badge badge-store" href="/search/?source=godot_store" title="See Godot Asset Store assets">Godot Asset Store</a>
      <% } else if (it?.info?.provider === 'godot_asset_library') { %>
      <a class="badge badge-legacy" href="/search/?source=godot_asset_library" title="See Legacy Asset Library assets">Asset Library</a>
      <% } %>
      <% if (it?._locals?.loggedIn === true) { %>
      <div class="dropdown no-text-select" onclick="window.godotLibrary.dropdown.showContent(event, this)">
        <span class="iconify" data-icon="akar-icons:more-horizontal" aria-hidden="true"></span>
        <div class="options">
          <% if (it?.info?.saved === true) { %>
          <a href="#" data-save-asset="<%= linkId %>" data-saved="true" title="Unsave asset">Unsave</a>
          <% } else { %>
          <a href="#" data-save-asset="<%= linkId %>" data-saved="false" title="Save asset">Save</a>
          <% } %>
          <% if (it?._locals?.role === 'admin') { %>
          <% if (it?.info?.featured === true) { %>
          <a href="/admin/feature-post/<%= linkId %>"
            onclick="window.godotLibrary.dropdown.callRouteAjax(event, '/admin/feature-post/<%= linkId %>', 'Post successfully featured')"
            title="Remove from 'Assets We Love' on homepage">Unfeature</a>
          <% } else { %>
          <a href="/admin/feature-post/<%= linkId %>"
            onclick="window.godotLibrary.dropdown.callRouteAjax(event, '/admin/feature-post/<%= linkId %>', 'Post successfully featured')"
            title="Add to 'Assets We Love' on homepage">Feature</a>
          <% } %>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% if (!it?.featured) { %>
    <a class="media" href="<%= assetHref %>" tabindex="-1" aria-hidden="true">
      <div class="background">
        <div class="mask">
          <img src="<%= generateProxyUrl(cardImage, 100, 100) %>"
            data-srcset="<%= generateProxyUrl(cardImage, 320, 180) %> 320w, <%= generateProxyUrl(cardImage, 480, 270) %> 480w, <%= generateProxyUrl(cardImage, 640, 360) %> 640w, <%= generateProxyUrl(cardImage, 800, 450) %> 800w"
            data-sizes="auto"
            data-src="<%= generateProxyUrl(cardImage) %>"
            data-fallback-image="<%= cardImage %>"
            alt="" class="lazyload" width="400" height="225">
        </div>
      </div>
    </a>
    <% } %>
  </div>
  <div class="body">
    <div class="top">
      <div class="icon">
        <img
          src="<%= generateProxyUrl(it?.info?.icon_url ?? 'https://avatars.githubusercontent.com/u/42072863?s=200&v=4', 50, 50) %>"
          width="37" height="37" alt="<%= it?.info?.title %> icon image">
      </div>
      <div class="info">
        <div class="author"><%= it?.info?.author ?? 'Failed to load'%></div>
        <div class="title">
          <a href="<%= assetHref %>" title="Visit asset information page">
            <%= it?.info?.title ?? 'Unable to load the asset' %>
          </a>
        </div>
      </div>
    </div>
    <p class="card-description" title="<%= it?.info?.quick_description ?? '' %>"><%= it?.info?.quick_description ?? 'For some reason we\'re unable to load this asset information right now' %>
    </p>
    <div class="meta">
      <% if (it?.context != null && it.context !== '') { %>
      <span class="meta-item meta-date"><%= it.context %></span>
      <% } %>
      <% if (it?.info?.version_string != null && it.info.version_string !== '') { %>
      <span class="meta-item meta-version">v<%= it.info.version_string %></span>
      <% } %>
      <% if (it?.info?.type != null && it.info.type !== '') { %>
      <span class="meta-item meta-type"><%= it.info.type %></span>
      <% } %>
      <% if (it?.info?.support_level != null && it.info.support_level !== '' && it.info.support_level !== 'None') { %>
      <span class="meta-item meta-support"><%= it.info.support_level %></span>
      <% } %>
    </div>
  </div>
  <div class="footer">
    <div class="rating">
      <span class="rating-summary">
        <% if (total > 0) { %>
        <span class="iconify" data-icon="bi:hand-thumbs-up-fill" aria-hidden="true"></span>
        <%= `${approval}% approval · ${total} rating${total === 1 ? '' : 's'}` %>
        <% } else if (storeScore !== null) { %>
        <span class="store-score" title="No local ratings yet · score from the Godot Asset Store">
          Store score <%= storeScoreDisplay %><span class="store-score-asterisk" aria-hidden="true">*</span>
        </span>
        <% } else { %>
        No ratings yet
        <% } %>
      </span>
      <span class="visually-hidden"><%= ratingDetail %></span>
    </div>
    <div class="card-actions-cta">
      <a class="card-cta" href="<%= assetHref %>"
        title="Open <%= it?.info?.title ?? 'asset' %> details">View details</a>
    </div>
  </div>
  <% if (it?.featured) { %>
  <a class="media" href="<%= assetHref %>" tabindex="-1" aria-hidden="true">
    <div class="background">
      <div class="mask">
        <img src="<%= generateProxyUrl(cardImage, 100, 100) %>"
          data-src="<%= generateProxyUrl(cardImage) %>"
          data-fallback-image="<%= cardImage %>"
          alt="" class="lazyload">
      </div>
    </div>
  </a>
  <% } %>
  <a class="card-link-overlay" href="<%= assetHref %>" tabindex="-1" aria-hidden="true"
    aria-label="Open <%= it?.info?.title ?? 'asset' %> details"></a>
</article>

