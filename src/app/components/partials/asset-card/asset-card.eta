<% 
var generateProxyUrl = it?._locals?.functions?.generateProxyUrl
var cardImage = it?.info?.card_banner ?? it?.info?.icon_url ?? '/images/noimage.png'

if (typeof cardImage !== 'string' || /(?:youtube\.com|youtu\.be|\.(?:mp4|webm|mov))(?:[?#]|$)/i.test(cardImage)) {
  cardImage = it?.info?.icon_url ?? '/images/noimage.png'
}

var assetId = it?.info?.asset_id ?? ''
var assetSlug = encodeURI(String(it?.info?.title ?? '').replace(/\s/g, '-')).toLocaleLowerCase()
var assetHref = `/asset/${assetId}/${assetSlug}`
if (it?.sourceUrl != null && it.sourceUrl !== '') {
  assetHref += '?from=' + encodeURIComponent(it.sourceUrl)
}

var upvotes = Number(it?.info?.upvotes) || 0
var downvotes = Number(it?.info?.downvotes) || 0
var total = upvotes + downvotes
var approval = total > 0 ? Math.round((upvotes / total) * 100) : 0
var ratingDetail = total > 0
  ? `${approval}% approval (${upvotes} positive, ${downvotes} negative)`
  : 'No ratings yet'
%>

<article class="asset-card <%= it?.featured ? 'featured' : 'normal' %>" id="asset-<%= assetId %>">
  <div class="head">
    <div class="badges">
      <a class="badge badge-blue" href="/category/<%= it?.info?.category?.toLocaleLowerCase() %>"
        title="See assets in this category"><%= it?.info?.category ?? 'ERR' %></a>
      <a class="badge badge-purple" href="/engine/<%= it?.info?.godot_version?.toLocaleLowerCase() %>"
        title="See assets for this engine version"><%= it?.info?.godot_version ?? 'ERR' %></a>
      <% if (it?._locals?.loggedIn === true) { %>
      <div class="dropdown no-text-select" onclick="window.godotLibrary.dropdown.showContent(event, this)">
        <span class="iconify" data-icon="akar-icons:more-horizontal" aria-hidden="true"></span>
        <div class="options">
          <% if (it?.info?.saved === true) { %>
          <a href="#" data-save-asset="<%= assetId %>" data-saved="true" title="Unsave asset">Unsave</a>
          <% } else { %>
          <a href="#" data-save-asset="<%= assetId %>" data-saved="false" title="Save asset">Save</a>
          <% } %>
          <% if (it?._locals?.role === 'admin') { %>
          <% if (it?.info?.featured === true) { %>
          <a href="/admin/feature-post/<%= assetId %>"
            onclick="window.godotLibrary.dropdown.callRouteAjax(event, '/admin/feature-post/<%= assetId %>', 'Post successfully featured')"
            title="Remove from 'Assets We Love' on homepage">Unfeature</a>
          <% } else { %>
          <a href="/admin/feature-post/<%= assetId %>"
            onclick="window.godotLibrary.dropdown.callRouteAjax(event, '/admin/feature-post/<%= assetId %>', 'Post successfully featured')"
            title="Add to 'Assets We Love' on homepage">Feature</a>
          <% } %>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% if (!it?.featured) { %>
    <a class="media" href="<%= assetHref %>" tabindex="-1" aria-hidden="true">
      <div class="background">
        <div class="mask">
          <img src="<%= generateProxyUrl(cardImage, 100, 100) %>"
            data-src="<%= generateProxyUrl(cardImage) %>"
            data-fallback-image="<%= cardImage %>"
            alt="" class="lazyload">
        </div>
      </div>
    </a>
    <% } %>
  </div>
  <div class="body">
    <div class="top">
      <div class="icon">
        <img
          src="<%= generateProxyUrl(it?.info?.icon_url ?? 'https://avatars.githubusercontent.com/u/42072863?s=200&v=4', 50, 50) %>"
          alt="<%= it?.info?.title %> icon image">
      </div>
      <div class="info">
        <div class="author"><%= it?.info?.author ?? 'Failed to load'%></div>
        <div class="title">
          <a href="<%= assetHref %>" title="Visit asset information page">
            <%= it?.info?.title ?? 'Unable to load the asset' %>
          </a>
        </div>
      </div>
    </div>
    <p class="card-description" title="<%= it?.info?.quick_description ?? '' %>"><%= it?.info?.quick_description ?? 'For some reason we\'re unable to load this asset information right now' %>
    </p>
    <div class="meta">
      <% if (it?.context != null && it.context !== '') { %>
      <span class="meta-item meta-date"><%= it.context %></span>
      <% } %>
      <% if (it?.info?.version_string != null && it.info.version_string !== '') { %>
      <span class="meta-item meta-version">v<%= it.info.version_string %></span>
      <% } %>
      <% if (it?.info?.type != null && it.info.type !== '') { %>
      <span class="meta-item meta-type"><%= it.info.type %></span>
      <% } %>
      <% if (it?.info?.support_level != null && it.info.support_level !== '' && it.info.support_level !== 'None') { %>
      <span class="meta-item meta-support"><%= it.info.support_level %></span>
      <% } %>
    </div>
  </div>
  <div class="footer">
    <div class="rating">
      <span class="rating-summary">
        <% if (total > 0) { %>
        <span class="iconify" data-icon="bi:hand-thumbs-up-fill" aria-hidden="true"></span>
        <%= `${approval}% approval · ${total} rating${total === 1 ? '' : 's'}` %>
        <% } else { %>
        No ratings yet
        <% } %>
      </span>
      <span class="visually-hidden"><%= ratingDetail %></span>
    </div>
    <div class="card-actions-cta">
      <a class="card-cta" href="<%= assetHref %>"
        title="Open <%= it?.info?.title ?? 'asset' %> details">View details</a>
    </div>
  </div>
  <% if (it?.featured) { %>
  <a class="media" href="<%= assetHref %>" tabindex="-1" aria-hidden="true">
    <div class="background">
      <div class="mask">
        <img src="<%= generateProxyUrl(cardImage, 100, 100) %>"
          data-src="<%= generateProxyUrl(cardImage) %>"
          data-fallback-image="<%= cardImage %>"
          alt="" class="lazyload">
      </div>
    </div>
  </a>
  <% } %>
</article>

