<%
var upvotes = Number(it?.info?.upvotes) || 0
var downvotes = Number(it?.info?.downvotes) || 0
var total = upvotes + downvotes
var approval = total > 0 ? Math.round((upvotes / total) * 100) : 0
%>
<div class="rating">
  <% if (total > 0) { %>
  <span class="rating-approval"><%= approval %>% approval</span>
  <span class="rating-count"><%= total %> rating<%= total === 1 ? '' : 's' %> (<%= upvotes %> positive, <%= downvotes %> negative)</span>
  <% } else { %>
  <span class="rating-count">No ratings yet</span>
  <% } %>
</div>
