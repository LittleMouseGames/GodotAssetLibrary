<% if(it?._locals?.promobarMessage) { %>
<section class="promobar">
  <div class="contents">
    <div class="text"><%~ it?._locals?.promobarMessage %> </div>
    <!-- <span class="iconify" data-icon="ant-design:close-circle-filled"></span> -->
  </div>
</section>
<% } %>
<nav>
  <div class="contents">
    <div class="brand">
      <a href="/" title="Go back to Godot Asset Library homepage" aria-label="Godot Asset Library homepage">
        <img src="/images/logo-square.png?cache=<%= it?._locals?.buildString %>" alt="Godot Asset Library logo">
        <span class="brand-name">
          <span class="brand-title">Godot Assets</span>
          <span class="brand-subtitle">an Open Source project</span>
        </span>
      </a>
    </div>
    <form method="GET" action="/search/" class="search-container" role="search">
      <div class="search">
        <span class="iconify" data-icon="eva:search-outline"></span>
        <label class="visually-hidden" for="site-search">Search for your next asset</label>
        <input id="site-search" type="search" placeholder="Search for your next asset..." name="q" autocomplete="off"
          value="<%= it?.originalQuery ? it?.originalQuery : '' %>">
        <button type="button" class="iconify close" data-icon="carbon:close" aria-label="Close search"></button>
      </div>
    </form>
    <div class="links">
      <a href="<%= it?._locals?.functions?.buildCategoryPath('2d tools') %>" class="link" title="See assets in this category">2D Tools</a>
      <a href="<%= it?._locals?.functions?.buildCategoryPath('3d tools') %>" class="link" title="See assets in this category">3D Tools</a>
      <div class="dropdown categories no-text-select">
        <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
          aria-controls="nav-categories-panel"
          onclick="window.godotLibrary.dropdown.showContent(event, this)">
          <span class="value">More Categories</span>
          <span class="value mobile">Categories</span>
          <span class="iconify" data-icon="bxs:chevron-down"></span>
        </button>
        <div class="options" id="nav-categories-panel">
          <a href="<%= it?._locals?.functions?.buildCategoryPath('tools') %>" title="See assets in this category">Tools</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('shaders') %>" title="See assets in this category">Shaders</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('materials') %>" title="See assets in this category">Materials</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('scripts') %>" title="See assets in this category">Scripts</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('misc') %>" title="See assets in this category">Misc</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('templates') %>" title="See assets in this category">Templates</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('projects') %>" title="See assets in this category">Projects</a>
          <a href="<%= it?._locals?.functions?.buildCategoryPath('demos') %>" title="See assets in this category">Demos</a>
        </div>
      </div>
    </div>
    <div class="account actions">
      <button type="button" class="mobile-search-btn" aria-label="Open search" aria-expanded="false"
        aria-controls="site-search" onclick="window.godotLibrary.mobile.toggleSearch(event)">
        <span class="iconify" data-icon="eva:search-outline"></span>
      </button>
      <form id="godot-version-form" method="POST" action="/preferences/godot-version" class="preferences-form">
        <input type="hidden" name="returnTo" value="<%= it?._locals?.godotVersion?.returnTo ?? '/' %>">
      </form>
      <div class="dropdown godot-version no-text-select">
        <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
          aria-controls="nav-version-panel" title="Godot version"
          onclick="window.godotLibrary.dropdown.showContent(event, this)">
          <span class="value"><%= it?._locals?.godotVersion?.label ?? '4.x' %></span>
          <span class="iconify chevron" data-icon="bxs:chevron-down"></span>
        </button>
        <div class="options" id="nav-version-panel">
          <% const versionOptions = it?._locals?.godotVersion?.options || [] %>
          <% const currentVersion = it?._locals?.godotVersion?.current %>
          <% versionOptions.forEach(option => { %>
          <button type="submit" form="godot-version-form" name="version" value="<%= option.value %>"
            class="preference-option<%= currentVersion === option.value ? ' active' : '' %>">
            <%= option.label %>
          </button>
          <% }) %>
        </div>
      </div>
      <div class="dropdown theme no-text-select" data-theme-control>
        <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
          aria-controls="nav-theme-panel" title="Theme"
          onclick="window.godotLibrary.dropdown.showContent(event, this)">
          <span class="iconify theme-icon" data-icon="mdi:theme-light-dark" aria-hidden="true"></span>
          <span class="value theme-label">System</span>
          <span class="iconify chevron" data-icon="bxs:chevron-down"></span>
        </button>
        <div class="options" id="nav-theme-panel">
          <button type="button" class="preference-option" data-theme="system" data-theme-label="System">System</button>
          <button type="button" class="preference-option" data-theme="light" data-theme-label="Light">Light</button>
          <button type="button" class="preference-option" data-theme="dark" data-theme-label="Dark">Dark</button>
        </div>
      </div>
      <% if(it?._locals?.loggedIn === true) { %>
      <div class="dropdown no-text-select">
        <button type="button" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false"
          aria-controls="nav-account-panel"
          onclick="window.godotLibrary.dropdown.showContent(event, this)">
          <span class="iconify" data-icon="codicon:account"></span>
          <span class="value">My Account</span>
          <span class="iconify chevron" data-icon="bxs:chevron-down"></span>
        </button>
        <div class="options" id="nav-account-panel">
          <a href="/dashboard" title="Visit account dashboard">Dashboard</a>
          <a href="/dashboard/saved/" title="See my saved assets">Saved Assets</a>
          <a href="/dashboard/reviews/" title="See my reviewed assets">Reviewed Assets</a>
          <% if (it?._locals?.role === 'admin') { %><a href="/admin">Admin Dashboard</a> <% } %>
          <form method="POST" action="/api/users/logout" class="logout-form">
            <button type="submit" title="Sign out of account">Logout</button>
          </form>
        </div>
      </div>
      <% } else { %>
      <a href="/register" class="register">
        <span class="iconify" data-icon="codicon:account"></span>
        <div class="value">Register / Login</div>
      </a>
      <% } %>
    </div>
  </div>
</nav>
