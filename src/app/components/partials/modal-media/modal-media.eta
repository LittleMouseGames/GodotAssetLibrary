<div class="modal media-lightbox" role="dialog" aria-modal="true" aria-label="Image preview" aria-hidden="true"
  data-dialog="media">
  <div class="background" data-media-lightbox-close data-dialog-close></div>
  <div class="modal-media body">
    <div class="lightbox-header">
      <span class="lightbox-counter" data-lightbox-counter aria-live="polite"></span>
      <button type="button" class="close" data-media-lightbox-close data-dialog-close aria-label="Close image preview">×</button>
    </div>
    <button type="button" class="previous" data-media-lightbox-previous aria-label="Previous image">‹</button>
    <div class="image-container">
      <img src="/images/noimage.png" alt="" data-media-lightbox-image data-fallback-image="/images/noimage.png">
      <span class="lightbox-caption" data-lightbox-caption></span>
    </div>
    <button type="button" class="next" data-media-lightbox-next aria-label="Next image">›</button>
    <div class="lightbox-strip" data-lightbox-strip aria-label="All images"></div>
  </div>
</div>
