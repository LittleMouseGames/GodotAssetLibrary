<div class="modal install" role="dialog" aria-modal="true" aria-labelledby="install-dialog-title" aria-hidden="true"
  data-dialog="install">
  <div class="background" data-dialog-close></div>
  <div class="modal-install body">
    <% const assetTitle = it?.info?.title ?? 'this asset' %>
    <% const downloadUrl = it?.info?.download_url ?? '' %>
    <% const assetType = String(it?.info?.type ?? '').toLocaleLowerCase() %>
    <% const isProjectLike = /project|template|demo/.test(assetType) %>
    <% const isPluginLike = /plugin|addon/.test(assetType) %>
    <% const isShaderLike = /shader/.test(assetType) %>
    <% const isMaterialLike = /material|texture/.test(assetType) %>
    <% const isModelLike = /model|mesh|3d/.test(assetType) %>

    <div class="install-header">
      <h2 id="install-dialog-title">Install <span class="asset-name"><%= assetTitle %></span></h2>
      <button type="button" class="close" data-dialog-close aria-label="Close installation help">&times;</button>
    </div>
    <% if (it?.info?.godot_version || it?.info?.version_string) { %>
    <p class="compat">
      Godot <strong><%= it?.info?.godot_version ?? 'unknown' %></strong><% if (it?.info?.version_string) { %>
      &middot; version v<%= it?.info?.version_string %><% } %>
      <% const cost = String(it?.info?.cost ?? '0') %>
      &middot; <%= cost === '' || cost === '0' ? 'Free' : cost %>
      &middot; <%= it?.info?.support_level ? (it.info.support_level + ' support') : 'community support' %>
    </p>
    <% } %>

    <div class="install-quick">
      <span class="install-quick-icon" aria-hidden="true">
        <span class="iconify" data-icon="mdi:rocket-launch-outline"></span>
      </span>
      <div class="install-quick-body">
        <h3>Quickest &mdash; install from inside Godot</h3>
        <p>In the Godot editor, open the <strong>AssetLib</strong> tab and search for
          &ldquo;<strong><%= assetTitle %></strong>&rdquo;, then press Download.</p>
      </div>
      <button type="button" class="copy-btn" data-copy-text="<%= assetTitle %>">Copy name</button>
    </div>

    <div class="install-steps">
      <div class="install-step">
        <span class="step-number" aria-hidden="true">1</span>
        <div class="step-body">
          <h3>Download the ZIP archive</h3>
          <% if (typeof downloadUrl === 'string' && downloadUrl !== '') { %>
          <a class="download" href="<%= downloadUrl %>" target="_blank" rel="noopener noreferrer"
            title="Download ZIP archive of asset">
            <span class="iconify" data-icon="mdi:download" aria-hidden="true"></span>
            Download ZIP
            <span class="hint">(opens in a new tab)</span>
          </a>
          <% } else { %>
          <p class="no-download">No download link is available for this asset right now.</p>
          <% } %>
        </div>
      </div>
      <div class="install-step">
        <span class="step-number" aria-hidden="true">2</span>
        <div class="step-body">
          <h3>Add it to your project</h3>
          <% if (isProjectLike) { %>
          <p id="manual-install-text">Download the ZIP archive, extract it, and open the included <strong>project.godot</strong> file to run it
            as a project in Godot.</p>
          <% } else if (isPluginLike) { %>
          <p id="manual-install-text">Download the ZIP archive, extract it, and copy the contents into your project&rsquo;s
            <span class="code">addons/</span> folder, then enable the plugin in <strong>Project &gt; Project
              Settings &gt; Plugins</strong>.</p>
          <% } else if (isShaderLike || isMaterialLike || isModelLike) { %>
          <p id="manual-install-text">Download the ZIP archive and extract it, then copy the files into the matching folder of your project
            (for example <span class="code">shaders/</span>, <span class="code">materials/</span> or
            <span class="code">models/</span>) and use them in your scenes. No plugin activation is required.</p>
          <% } else { %>
          <p id="manual-install-text">Download the ZIP archive and extract it, then check the included <strong>README</strong> (or the
            asset&rsquo;s repository) for the recommended folder and setup steps. If the archive contains an
            <span class="code">addons/</span> folder, copy it into your project and enable the plugin in
            <strong>Project &gt; Project Settings &gt; Plugins</strong>.</p>
          <% } %>
          <button type="button" class="copy-btn" data-copy-selector="#manual-install-text">Copy instructions</button>
        </div>
      </div>
    </div>
  </div>
</div>
